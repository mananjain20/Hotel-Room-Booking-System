# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/hotel_booking?retryWrites=true&w=majority

# ── JSON Web Token ────────────────────────────────────────────────────────────
# Use a long, random secret — e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set this to your frontend's URL in production (e.g. https://yourdomain.com)
CLIENT_ORIGIN=http://localhost:3000

# ── Initial Manager Account (for seed:manager script) ─────────────────────────
MANAGER_NAME=System Manager
MANAGER_EMAIL=manager@hotel.com
MANAGER_PASSWORD=ReplaceWithStrongPassword123!
