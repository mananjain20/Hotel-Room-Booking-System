{
  "info": {
    "name": "Hotel Room Booking System — Phase 3 (Auth & Bookings API)",
    "_postman_id": "hotel-room-booking-phase3",
    "description": "Postman collection covering authentication, role authorization, and booking management endpoints.\n\nSetup:\n1. Base URL: http://localhost:5000\n2. Run 'Register Guest' or 'Login Guest' to get GUEST_TOKEN.\n3. Run 'Login Manager' to get MANAGER_TOKEN.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000" },
    { "key": "GUEST_TOKEN", "value": "" },
    { "key": "MANAGER_TOKEN", "value": "" },
    { "key": "ROOM_ID", "value": "" },
    { "key": "BOOKING_ID", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Guest",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Smith\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{BASE_URL}}/api/auth/register",
            "description": "Public registration for a guest account. Returns JWT token and guest data."
          }
        },
        {
          "name": "Register attempt with manager role (forced to guest)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Attacker\",\n  \"email\": \"attacker@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"manager\"\n}"
            },
            "url": "{{BASE_URL}}/api/auth/register",
            "description": "Verifies that role: 'manager' is ignored and user is registered as role: 'guest'."
          }
        },
        {
          "name": "Login Guest",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{BASE_URL}}/api/auth/login",
            "description": "Authenticate guest account. Returns JWT token."
          }
        },
        {
          "name": "Get Current Profile (/api/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{GUEST_TOKEN}}" }
            ],
            "url": "{{BASE_URL}}/api/auth/me",
            "description": "Returns details of current authenticated user."
          }
        }
      ]
    },
    {
      "name": "2. Bookings Management",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{GUEST_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"{{ROOM_ID}}\",\n  \"checkIn\": \"2026-10-10\",\n  \"checkOut\": \"2026-10-15\"\n}"
            },
            "url": "{{BASE_URL}}/api/bookings",
            "description": "Creates a booking for valid dates and calculates total price."
          }
        },
        {
          "name": "Create Overlapping Booking (Conflict check)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{GUEST_TOKEN}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": \"{{ROOM_ID}}\",\n  \"checkIn\": \"2026-10-12\",\n  \"checkOut\": \"2026-10-17\"\n}"
            },
            "url": "{{BASE_URL}}/api/bookings",
            "description": "Fails with 409 Conflict due to date overlap."
          }
        },
        {
          "name": "Get My Bookings (GET /api/bookings/my)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{GUEST_TOKEN}}" }
            ],
            "url": "{{BASE_URL}}/api/bookings/my",
            "description": "Returns bookings belonging only to the authenticated guest."
          }
        },
        {
          "name": "Get All Bookings (GET /api/bookings — Manager)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{MANAGER_TOKEN}}" }
            ],
            "url": "{{BASE_URL}}/api/bookings",
            "description": "Manager retrieves all guest bookings."
          }
        },
        {
          "name": "Get Booking Details by ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{GUEST_TOKEN}}" }
            ],
            "url": "{{BASE_URL}}/api/bookings/{{BOOKING_ID}}",
            "description": "Retrieves booking details for owner guest or manager."
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{GUEST_TOKEN}}" }
            ],
            "url": "{{BASE_URL}}/api/bookings/{{BOOKING_ID}}/cancel",
            "description": "Cancels a booking (status set to 'cancelled')."
          }
        }
      ]
    }
  ]
}
